<section class="video-import">
  <h1><%= @provider == :vimeo ? 'Vimeo' : 'YouTube' %>からインポート</h1>
  <div class="video-box">
    <div class="video-preview">
      <% if @image_url.present? %>
        <img src="<%= h(@image_url) %>" alt="動画プレビュー">
      <% else %>
        <div class="provider-fallback-preview"><i class="fas fa-film"></i><strong>動画プレビュー</strong></div>
      <% end %>
    </div>
    <form action="/reference/preview/confirm" method="post">
      <input type="hidden" name="reference_url" value="<%= h(@url) %>">
      <input type="hidden" name="reference_imageurl" value="<%= h(@image_url) %>">
      <div class="range-line">
        <label>開始<input type="text" name="reference_start_time" value="<%= h(@start_time) %>" placeholder="00:00" inputmode="numeric" required></label>
        <label>終了<input type="text" name="reference_end_time" value="<%= h(@end_time) %>" placeholder="00:30" inputmode="numeric" required></label>
      </div>
      <input class="video-range" type="range" min="0" max="3600" value="<%= time_seconds(@start_time).to_i %>" aria-label="開始位置">
      <div class="video-actions">
        <button class="button" type="button" onclick="this.closest('form').querySelector('.range-line').classList.toggle('is-open')">範囲指定する</button>
        <button class="button primary" type="submit">インポート</button>
      </div>
    </form>
  </div>
</section>
<script>
  document.querySelector('.video-range').addEventListener('input', function() {
    const seconds = Number(this.value);
    const minutes = Math.floor(seconds / 60);
    const time = [Math.floor(minutes / 60), minutes % 60, seconds % 60];
    this.form.elements.reference_start_time.value = (minutes >= 60 ? time : time.slice(1)).map(n => String(n).padStart(2, '0')).join(':');
    this.form.querySelector('.range-line').classList.add('is-open');
  });
</script>

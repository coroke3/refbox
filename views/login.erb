<section class="auth-page">
  <a class="auth-brand" href="/">refbox</a>
  <div class="form-card">
    <p class="eyebrow">WELCOME BACK</p>
    <h1>ログイン</h1>
    <form class="stack" action="/login" method="post">
      <label>ユーザー名<input name="user_name" maxlength="40" required autofocus></label>
      <label>パスワード<input type="password" name="password" minlength="8" required></label>
      <button class="button primary" type="submit">ログイン</button>
    </form>
    <p class="switch">
      初めて使う方は
      <a href="/signup">新規登録</a>
    </p>
  </div>
</section>

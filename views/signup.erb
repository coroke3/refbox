<section class="auth-page">
  <a class="auth-brand" href="/">refbox</a>
  <div class="form-card">
    <p class="eyebrow">START YOUR BOX</p>
    <h1>新規登録</h1>
    <form class="stack" action="/signup" method="post">
      <label>ユーザー名<input name="user_name" maxlength="40" required autofocus></label>
      <label>パスワード<input type="password" name="password" minlength="8" required></label>
      <button class="button primary" type="submit">アカウントを作成</button>
    </form>
    <p class="switch">
      登録済みの方は
      <a href="/login">ログイン</a>
    </p>
  </div>
</section>
